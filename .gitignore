# ---- build output (regenerated by build.ps1) ----
build/
*.o
*.efi
*.EFI
*.map
*.log

# ---- disk images and firmware blobs ----
# Never commit disk images: they may contain third-party OS files or games.
*.img
*.ima
*.vhd
*.vmdk
*.fd
*.iso

# ---- python ----
__pycache__/
*.py[cod]

# ---- editor / OS noise ----
.vs/
.vscode/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---- kept out of the published tree ----
# Local-only harnesses that drive third-party disk images (MS-DOS,
# CardPuter86 game disks).  They are useful on a machine that owns those
# images, but they are not part of the public repository.
tools/import_cardputer.py
tools/dos_reference.py
tools/uefidos_shot.py
tools/compat_test.ps1
tools/repro_hang.ps1
# screenshots of third-party programs
docs/shots/

# Windows media / installed trees used for local testing (Microsoft files)
win1x-src/
