# UEFI-DOS -- one-command build for Unix hosts (Linux/macOS/WSL) and Windows.
#
#   make                 build/BOOTX64.EFI            (64-bit UEFI application)
#   make all             both BOOTX64.EFI and BOOTIA32.EFI
#   make image           build/UEFIDOS.img            (bootable FAT32 image)
#   make sdk             native 64/32-bit SDK examples (build/HELLO64.EXE, ...)
#   make run             boot the image in QEMU (needs qemu-system-x86_64 + OVMF)
#   make host            host test harness (Windows only: it uses Win32 APIs)
#   make test            host harness tests + instruction test vectors (Windows)
#   make clean
#
# Requirements: a PE-targeting GCC (mingw-w64), GNU make, Python 3.
#   Debian/Ubuntu: sudo apt install build-essential gcc-mingw-w64-x86-64 \
#                                gcc-mingw-w64-i686 python3
#   Fedora:        sudo dnf install make gcc python3 \
#                                mingw64-gcc mingw32-gcc
#   macOS (brew):  brew install mingw-w64 make python3
# Or skip the toolchain entirely: docker build -t uefi-dos . && \
#   docker run --rm -v "$PWD/out:/src/build" uefi-dos

CC64   ?= x86_64-w64-mingw32-gcc
CC32   ?= i686-w64-mingw32-gcc
PYTHON ?= python3
BUILD  ?= build

# Native Windows: one compiler serves both targets (-m32 for the 32-bit build).
ifeq ($(OS),Windows_NT)
  ifeq ($(shell command -v $(CC64) 2>/dev/null),)
    CC64 := gcc
    CC32 := gcc -m32
  endif
endif

CFLAGS_COMMON = -O2 -std=gnu11 -ffreestanding -Wall -Wextra \
                -fno-asynchronous-unwind-tables -fno-unwind-tables \
                -fno-stack-protector -fno-builtin -fno-ident -Isrc
CFLAGS64 = $(CFLAGS_COMMON) -m64 -mno-red-zone -mno-stack-arg-probe
CFLAGS32 = $(CFLAGS_COMMON) -m32 -mno-stack-arg-probe
LDFLAGS  = -nostdlib -Wl,--subsystem,10 -Wl,-e,efi_main \
           -Wl,--no-insert-timestamp -Wl,--enable-reloc-section

# One list, compiled twice.  Order does not matter; every object is independent.
SRC = src/uefi/main.c \
      src/uefi/efi_plat.c \
      src/common/util.c \
      src/common/divdi3.c \
      src/common/cp437.c \
src/common/font8x8.c \
      src/fs/fat.c \
      src/kernel/dos.c \
      src/shell/shell.c \
      src/api/dosapi.c \
      src/api/native.c \
      src/emu/emu.c \
      src/emu/int21.c \
      src/emu/fcb.c \
      src/emu/int2f.c src/emu/int33.c \
      src/emu/dpmi.c

OBJ64 = $(patsubst %.c,$(BUILD)/obj64/%.o,$(SRC))
OBJ32 = $(patsubst %.c,$(BUILD)/obj32/%.o,$(SRC))

HOST_SRC = src/host/host_main.c src/host/host_plat.c src/host/dual_test.c \
           src/host/fat16_test.c src/fs/fat.c src/kernel/dos.c src/shell/shell.c \
           src/api/dosapi.c src/api/native.c src/emu/itest.c src/emu/emu.c \
           src/emu/int21.c src/emu/fcb.c src/emu/int2f.c src/emu/int33.c src/emu/dpmi.c

all: $(BUILD)/BOOTX64.EFI $(BUILD)/BOOTIA32.EFI

$(BUILD)/BOOTX64.EFI: $(OBJ64)
	@mkdir -p $(dir $@)
	$(CC64) -m64 $(LDFLAGS) -o $@ $^ -lgcc
	@echo "built: $@"

$(BUILD)/BOOTIA32.EFI: $(OBJ32)
	@mkdir -p $(dir $@)
	$(CC32) -m32 $(LDFLAGS) -o $@ $^
	@echo "built: $@"

$(BUILD)/obj64/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC64) $(CFLAGS64) -c $< -o $@

$(BUILD)/obj32/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC32) $(CFLAGS32) -c $< -o $@

# ---- bootable image -------------------------------------------------------
# Programs (the .COM utilities and test vectors) are generated by the Python
# tools in tools/, exactly as build.ps1 does on Windows.
PROGS = HELLO.COM TELETYPE.COM MZEXE.EXE RUNNER.COM VRAM.COM UPCALL.COM \
        DTATEST.COM I2FTEST.COM DPMITEST.COM FCBTEST.COM INFO.COM CLOCK.COM \
        HEX.COM SUM.COM CAL.COM KEYTEST.COM DOS4TEST.COM

progs:
	@mkdir -p $(BUILD)
	$(PYTHON) tools/make_hello.py $(BUILD)
	$(PYTHON) tools/make_pm_tests.py $(BUILD)
	$(PYTHON) tools/make_fcb_test.py $(BUILD)
	$(PYTHON) tools/make_tools.py $(BUILD)
	$(PYTHON) tools/make_keytest.py $(BUILD)
	$(PYTHON) tools/make_dos4_test.py $(BUILD)

image: $(BUILD)/BOOTX64.EFI $(BUILD)/BOOTIA32.EFI progs sdk
	$(PYTHON) tools/make_image.py $(BUILD)/UEFIDOS.img --size-mb 64 \
	  --boot $(BUILD)/BOOTX64.EFI --boot-ia32 $(BUILD)/BOOTIA32.EFI \
	  --text "HELLO.TXT=Hello UEFI-DOS!" --dir TESTDIR \
	  --text "TESTDIR/INNER.TXT=inner file" \
	  --text 'CONFIG.SYS=FILES=20\nLASTDRIVE=D\n' \
	  $(foreach p,$(PROGS),--file $(BUILD)/$(p)=$(p)) \
	  --file $(BUILD)/HELLO64.EXE=HELLO64.EXE \
	  --file $(BUILD)/FILET64.EXE=FILET64.EXE --file $(BUILD)/FILET32.EXE=FILET32.EXE \
	  --autoexec "VER\nDIR\nTYPE HELLO.TXT\nHELLO\nTELETYPE\nMZEXE\nRUNNER\nVRAM\nAPITEST\nUPCALL\nDTATEST\nI2FTEST\nDPMITEST\nECHO WRITE-OK\nRUN64 HELLO64.EXE\nRUN64 FILET64.EXE -l *.TXT\nCONFIG\nFCBTEST\nDOS4TEST\nINFO\nCAL\nSUM HELLO.TXT\nHEX HELLO.TXT"
	@echo "built: $(BUILD)/UEFIDOS.img (AUTOEXEC ends at a live C:\\> prompt)"

# ---- native SDK ----------------------------------------------------------
sdk:
	$(MAKE) -C sdk CC64=$(CC64) CC32=$(CC32) OUT=../$(BUILD)

# ---- host harness (Windows only: Win32 console + file APIs) --------------
host:
	$(CC64) -m64 -O2 -std=gnu11 -Wall -Wextra -DUEFIDOS_HOST -Isrc \
	  $(HOST_SRC) -o $(BUILD)/hosttest.exe
	@echo "built: $(BUILD)/hosttest.exe"

test: host sdk
	$(BUILD)/hosttest.exe --itest
	$(BUILD)/hosttest.exe --shell $(BUILD)/UEFIDOS.img "VER" "HELLO" "APITEST" "RUN64 HELLO64.EXE"

# ---- run -----------------------------------------------------------------
QEMU     ?= qemu-system-x86_64
OVMF_DIR ?= /usr/share/OVMF
run: image
	@test -f $(OVMF_DIR)/OVMF_CODE.fd || \
	  { echo "OVMF not found in $(OVMF_DIR); set OVMF_DIR="; exit 1; }
	cp $(OVMF_DIR)/OVMF_VARS.fd $(BUILD)/vars.fd
	$(QEMU) -m 256 -smp 1 -machine pc \
	  -drive if=pflash,format=raw,readonly=on,file=$(OVMF_DIR)/OVMF_CODE.fd \
	  -drive if=pflash,format=raw,file=$(BUILD)/vars.fd \
	  -drive file=$(BUILD)/UEFIDOS.img,if=ide,index=0,media=disk,format=raw \
	  -net none

clean:
	rm -rf $(BUILD)
	$(MAKE) -C sdk clean

.PHONY: all image progs sdk host test run clean
.DEFAULT_GOAL := all
